# Copie para supabase/env.secrets (não commitar) e envie com:
#   npm run supabase:secrets
# Necessário quando VITE_SUPABASE_EDGE_API=true no front.

SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — generateContent (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=90000
GEMINI_RPM=15
GEMINI_RPD=1000
PROSPECTOS_COLETA_FONTE=gemini
PROSPECTOS_GEMINI_FALLBACK_OSM=false
PROSPECTOS_GEMINI_MAX=20

NOMINATIM_CONTACT_EMAIL=seu-email@dominio.com
BRASILAPI_CNPJ_URL=https://brasilapi.com.br/api/cnpj/v1
