{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/rc-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "{src/assets/rc/**,src/lib/rc/**,src/lib/impressaoPlanos/montserratPdfFonts.js}"
    },
    "api/clicksign-catchall.js": {
      "maxDuration": 30
    },
    "api/clicksign-download.js": {
      "maxDuration": 30
    },
    "api/clicksign-webhook.js": {
      "maxDuration": 15
    },
    "api/admin-users.js": {
      "maxDuration": 30
    },
    "api/audit-logs.js": {
      "maxDuration": 30
    },
    "api/consulta-cnpj.js": {
      "maxDuration": 15
    },
    "api/geocode-prestador.js": {
      "maxDuration": 30
    },
    "api/map-osm.js": {
      "maxDuration": 25
    },
    "api/prospectos-osm-coletar.js": {
      "maxDuration": 60
    },
    "api/cep-lookup.js": {
      "maxDuration": 15
    },
    "api/gemini-rate.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/clicksign/:path*",
      "destination": "/api/clicksign-catchall?path=:path*"
    },
    {
      "source": "/api/nominatim-search",
      "destination": "/api/map-osm?_route=nominatim"
    },
    {
      "source": "/api/overpass-poi",
      "destination": "/api/map-osm?_route=overpass"
    },
    {
      "source": "/api/prospectos-gemini-status",
      "destination": "/api/prospectos-osm-coletar?_route=gemini-status"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
