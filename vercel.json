{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/rc-pdf.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{src/assets/rc/**,src/lib/rc/**,src/lib/impressaoPlanos/montserratPdfFonts.js}"
    },
    "api/clicksign/[...path].js": {
      "maxDuration": 30
    },
    "api/clicksign-catchall.js": {
      "maxDuration": 30
    },
    "api/clicksign-download.js": {
      "maxDuration": 30
    },
    "api/clicksign-webhook.js": {
      "maxDuration": 15
    },
    "api/admin-users.js": {
      "maxDuration": 30
    },
    "api/consulta-cnpj.js": {
      "maxDuration": 15
    },
    "api/geocode-prestador.js": {
      "maxDuration": 30
    },
    "api/nominatim-search.js": {
      "maxDuration": 15
    },
    "api/overpass-poi.js": {
      "maxDuration": 25
    },
    "api/prospectos-osm-coletar.js": {
      "maxDuration": 60
    },
    "api/prospectos-gemini-status.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/clicksign/:path*",
      "destination": "/api/clicksign-catchall?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
