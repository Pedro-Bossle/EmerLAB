# ============================================================
# zap.emerlab — modelo de variáveis de ambiente
# Copie para .env.local (nesta pasta ou na raiz do repositório)
# e preencha. NUNCA commite o arquivo com valores reais.
# Todas as chaves são de SERVIDOR (sem prefixo VITE_): o navegador
# nunca vê o token da WATI nem a service role do Supabase.
# ============================================================

# --- WATI ---------------------------------------------------
# ID do workspace (tenant). Aparece no "API Endpoint" do painel WATI:
#   https://live-mt-server.wati.io/<TENANT_ID>
# É o mesmo "ID" que o usuário digita na tela de login.
WATI_TENANT_ID=
# Token Bearer gerado em WATI → Connector → API → Generate new token
# (escopos mínimos: contacts:read, conversations:read, conversations:write,
#  messagetemplate:read — ou o escopo "api" completo)
WATI_API_TOKEN=
# Host da API (normalmente não precisa mudar)
WATI_API_BASE=https://live-mt-server.wati.io
# Número do canal WhatsApp com DDI, só dígitos (ex.: 5551999999999).
# Obrigatório para enviar templates e mudar status; útil com multi-número.
WATI_CHANNEL_NUMBER=

# --- Sessão do painel ---------------------------------------
# String aleatória longa. Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZAP_SESSION_SECRET=
# Duração do login em horas
ZAP_SESSION_HORAS=12

# --- Administrador inicial ----------------------------------
# Login de bootstrap (ID = WATI_TENANT_ID). Use o e-mail do dono da conta WATI.
# Depois de entrar, cadastre os demais usuários em Menu → Administração.
ZAP_ADMIN_EMAIL=
ZAP_ADMIN_SENHA=
ZAP_ADMIN_NOME=Administrador

# --- Supabase (usuários, departamentos, respostas rápidas) ---
# Pode ser o mesmo projeto do EmerLAB; as tabelas usam prefixo zap_.
# Rode supabase/schema.sql no SQL Editor antes do primeiro uso.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Webhook WATI (opcional, recomendado) --------------------
# Configure no WATI (Webhooks → Message Received / Session Message Sent):
#   https://SEU-DOMINIO/api/webhook?token=<ZAP_WEBHOOK_SECRET>
# Use só caracteres URL-safe (A-Z a-z 0-9 _ -). NÃO use # — a WATI corta o token
# (tudo depois de # vira fragmento e o painel responde 401).
# Com webhook: contador de não lidas e última mensagem em tempo real.
ZAP_WEBHOOK_SECRET=

# --- E-mail de convite (Resend) -----------------------------
# Ao criar um usuário, ele recebe um e-mail para criar a própria senha.
# Mesma chave/remetente do EmerLAB (domínio emerlab.com.br verificado na Resend).
# Sem a chave, o painel mostra o link do convite para o admin copiar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@emerlab.com.br
ZAP_EMAIL_FROM_NOME=Emerzap
# Endereço público do painel (usado no link do convite)
ZAP_PUBLIC_URL=https://zap.emerlab.com.br

# --- Avisos em tempo real (opcional; desligado por padrão) ----
# 1 = o servidor avisa o painel por Supabase Realtime quando uma conversa muda, e o painel reduz o polling
# (lista 30 s, chat 15 s). Exige o webhook da WATI acima e a chave PÚBLICA do Supabase abaixo.
# Se o canal cair, o painel volta sozinho ao polling de antes. Desligue com ZAP_REALTIME=0 (ou apague).
ZAP_REALTIME=
SUPABASE_ANON_KEY=

# --- Microsoft: Outlook e Teams (opcional; desligado por padrão) ----
# Passo a passo e riscos: docs/microsoft-outlook-teams.md. Rode supabase/migracao-microsoft.sql antes de ligar.
# Registro do app no Entra ID (Azure AD): plataforma WEB, Redirect URI = <ZAP_PUBLIC_URL>/api/ms/callback,
# permissões DELEGADAS (Mail.ReadWrite, Mail.Send, Team.ReadBasic.All, Channel.ReadBasic.All, ChannelMessage.Read.All,
# ChannelMessage.Send, User.Read, offline_access) com consentimento do administrador.
# Só liga com MS_ATIVO=true E as três chaves abaixo preenchidas. Desligue com MS_ATIVO=false (as abas voltam à prévia).
MS_ATIVO=
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
# Chave que cifra os refresh tokens no banco (texto longo e aleatório; guarde-a: trocar exige reconectar todo mundo)
MS_TOKEN_KEY=
# Opcional: mostrar só a equipe do Teams com este nome (ex.: Emerdog)
MS_TEAM_NOME=
# Opcional: vida da assinatura de webhook de canal, em minutos (padrão 60; confirmar o limite na doc da Microsoft)
MS_CANAL_MINUTOS=
# Cron diário que renova os webhooks (a Vercel envia este valor em Authorization: Bearer). Defina no projeto.
CRON_SECRET=

# --- Regras de atendimento ----------------------------------
# true = atendentes também veem conversas sem departamento (triagem)
ZAP_ATENDENTE_VE_SEM_DEPARTAMENTO=true

# --- Desenvolvimento local ----------------------------------
ZAP_API_PORT=3001
