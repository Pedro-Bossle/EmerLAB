# Copie este ficheiro para `.env.local` na raiz e preencha os valores.
# Nunca commite `.env.local` (já está no .gitignore).
# Variáveis GEMINI_* e PROSPECTOS_* são só de servidor — sem prefixo VITE_.

# --- Supabase (front) ---
VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# true = front chama Edge Functions; false/ausente = /api Vite ou Vercel
# VITE_SUPABASE_EDGE_API=false

# --- Gemini (servidor: Vite plugin, Vercel /api, ou secrets da Edge) ---
# Crie a chave em https://aistudio.google.com/apikey (AIza… ou AQ.…)
# Usa generateContent (não Interactions).
GEMINI_API_KEY=
# Padrão no código: gemini-3.5-flash-lite
# https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional se o modelo principal der 404
# GEMINI_MODEL_FALLBACK=gemini-flash-latest
# Timeout generateContent (ms)
GEMINI_TIMEOUT_MS=90000
# Limites do AI Studio (https://ai.google.dev/gemini-api/docs/rate-limits)
# RPM = pedidos por minuto; RPD = pedidos por dia (reset à meia-noite Pacific)
GEMINI_RPM=15
GEMINI_RPD=1000

# Coleta de prospectos: gemini | osm | auto
PROSPECTOS_COLETA_FONTE=gemini
PROSPECTOS_GEMINI_FALLBACK_OSM=false
PROSPECTOS_GEMINI_MAX=20
# PROSPECTOS_GEMINI_PAUSA_SEG=3600

# --- Outras APIs de servidor (opcional) ---
# NOMINATIM_CONTACT_EMAIL=seu-email@dominio.com
# SUPABASE_SERVICE_ROLE_KEY=
# CLICKSIGN_ACCESS_TOKEN=
# CLICKSIGN_API_BASE=
