# Modelo de variáveis de ambiente (raiz → .env.local)
# Copie as linhas que precisar. Não commite .env.local com segredos.

# --- Supabase (front) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_EDGE_API=false

# --- Servidor / APIs (sem VITE_) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_RPM=
# GEMINI_RPD=
# GEMINI_TIMEOUT_MS=
# PROSPECTOS_COLETA_FONTE=gemini
# PROSPECTOS_GEMINI_MAX=20
# PROSPECTOS_GEMINI_FALLBACK_OSM=false
# CLICKSIGN_ACCESS_TOKEN=
# API 3.0 (envelopes) — produção ou sandbox:
# CLICKSIGN_API_BASE=https://app.clicksign.com/api/v3
# CLICKSIGN_API_BASE=https://sandbox.clicksign.com/api/v3
# NÃO use https://api.clicksign.com.br/api/v1 (API antiga)
# CLICKSIGN_WEBHOOK_SECRET=
# Só em local, se testar webhook sem secret: CLICKSIGN_WEBHOOK_ALLOW_INSECURE_DEV=true
# NOMINATIM_CONTACT_EMAIL=

# --- Emer-Radar (prospecção Maps + planos) ---
# Dev: deixe vazio — o Vite faz proxy de /emeradar → http://127.0.0.1:8000
# Prod: cron via GitHub Actions (POST /api/emer-radar-cron → rewrite audit-logs) — sem Railway
# Hobby: máx. 12 Serverless Node; CEP/IBGE são Edge e não contam nesse limite
# EMER_RADAR_GITHUB_TOKEN=ghp_...
# EMER_RADAR_GITHUB_REPO=Pedro-Bossle/teste-emeradar
# EMER_RADAR_WORKFLOW_FILE=emer-radar-cron.yml
# Override raro (worker remoto direto): VITE_EMERADAR_DIRECT=true + VITE_EMERADAR_API_BASE=...
# No worker: CORS_ORIGINS=https://seu-emerlab.vercel.app

# --- Resend (e-mails: convite, senha, pipeline) ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@emerlab.com.br
# RESEND_FROM_NAME=EmerLAB
# EMAIL_INTERNAL_SECRET=
# SITE_URL=https://emerlab.vercel.app

# --- EmerMarketing (opcional; default https://marketing.emerlab.com.br) ---
# VITE_EMERMARKETING_URL=https://marketing.emerlab.com.br

# --- Outlook / MSAL (opcional) ---
# VITE_MSAL_CLIENT_ID=
# VITE_MSAL_TENANT_ID=
# Origem local (opcional). O redirect real é sempre {origem}/auth-redirect.html
# VITE_MSAL_REDIRECT_URI=http://localhost:5173
# Azure AD → registar: http://localhost:5173/auth-redirect.html
#   + https://emerlab.com.br/auth-redirect.html (+ www se usarem)
