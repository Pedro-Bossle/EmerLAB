# Modelo de variáveis de ambiente (raiz → .env.local)
# Copie as linhas que precisar. Não commite .env.local com segredos.

# --- Supabase (front) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_EDGE_API=false

# --- Servidor / APIs (sem VITE_) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_RPM=
# GEMINI_RPD=
# GEMINI_TIMEOUT_MS=
# PROSPECTOS_COLETA_FONTE=gemini
# PROSPECTOS_GEMINI_MAX=20
# PROSPECTOS_GEMINI_FALLBACK_OSM=false
# CLICKSIGN_ACCESS_TOKEN=
# CLICKSIGN_API_BASE=
# CLICKSIGN_WEBHOOK_SECRET=
# Só em local, se testar webhook sem secret: CLICKSIGN_WEBHOOK_ALLOW_INSECURE_DEV=true
# NOMINATIM_CONTACT_EMAIL=

# --- Outlook / MSAL (opcional) ---
# VITE_MSAL_CLIENT_ID=
# VITE_MSAL_TENANT_ID=
# URI da SPA (loginRedirect) — tem de existir no Azure, ex.:
# VITE_MSAL_REDIRECT_URI=http://localhost:5173
# O popup usa automaticamente: {origem}/auth-redirect.html
