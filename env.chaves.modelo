# Copie para .env.local na raiz. Preencha entre as aspas. Reinicie: npm run dev

# Supabase → Project Settings → API (front)
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase → API (npm run dev:api, RC PDF, admin)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Clicksign
CLICKSIGN_ACCESS_TOKEN=""
CLICKSIGN_API_BASE=""
CLICKSIGN_WEBHOOK_SECRET=""

# CNPJ (Brasil API via /api/consulta-cnpj): cache em dias no servidor e no browser (VITE_CNPJ_CACHE_DAYS)
CNPJ_CACHE_DAYS="3"
VITE_CNPJ_CACHE_DAYS="3"
# Legado (opcional, ainda lido se CNPJ_CACHE_DAYS não estiver definido):
# RECEITAWS_CACHE_DAYS="3"
